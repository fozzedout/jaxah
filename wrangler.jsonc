// Airis OS: one Worker is the whole site. Rules live in airis.contract.json.
{
  "name": "jaxah",
  "main": "worker.js",
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // / and /diagnostic go through the Worker so it can stamp the build.
    "run_worker_first": ["/api/*", "/", "/diagnostic"]
  },
  "routes": [
    { "pattern": "jaxah.com/*", "zone_name": "jaxah.com" }
  ],
  "observability": { "enabled": false }
  // No KV / D1 / R2 / Durable Object bindings, on purpose: keys and app data
  // live only in the visitor's browser.
}
