{
  "version": 2,
  "name": "Airis OS",
  "contract": "airis.contract.json",
  "note": "The catalogue. Schema and rules: airis.contract.json -> appEntry. An installed record (localStorage airis.installs.v1) is what runs.",
  "apps": [
    {
      "id": "session",
      "name": "Session",
      "icon": "◇",
      "url": "apps/session.html",
      "version": "1.2.1",
      "install": "code",
      "preinstalled": true,
      "launch": "auto",
      "category": "Agent",
      "description": "A blank session with a live agent. Bring your own key; it stays in this browser.",
      "size": "window",
      "desktop": {
        "width": 760,
        "height": 680
      },
      "phone": {
        "slot": "sheet"
      },
      "pinned": true,
      "capabilities": [
        "storage",
        "secrets",
        "net",
        "actions"
      ],
      "settings": {
        "presets": [
          {
            "id": "opencode-go",
            "label": "OpenCode Go",
            "transport": "proxy",
            "baseUrl": "/api/go",
            "upstream": "https://opencode.ai/zen/go/v1",
            "editable": false,
            "note": "relayed by this site at /api/go: opencode.ai blocks browser cross-origin calls, so the endpoint is fixed",
            "hint": "Relayed by this site — no setup needed",
            "headers": {
              "x-opencode-session": "{session}"
            }
          },
          {
            "id": "openrouter",
            "label": "OpenRouter",
            "transport": "direct",
            "baseUrl": "https://openrouter.ai/api/v1",
            "editable": false,
            "hint": "Calls the provider directly from this browser"
          },
          {
            "id": "openai-compatible",
            "label": "Custom endpoint",
            "transport": "direct",
            "baseUrl": "http://localhost:1234/v1",
            "editable": true
          }
        ]
      }
    },
    {
      "id": "store",
      "name": "Store",
      "icon": "⬡",
      "url": "apps/store.html",
      "version": "1.0.0",
